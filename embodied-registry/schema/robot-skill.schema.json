{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embodied-registry.dev/schema/robot-skill/0.1.json",
  "title": "Embodied Registry robot skill manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "policy", "hardware", "runtime", "evaluation"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1 },
        "license": { "type": "string" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "repository", "revision"],
          "properties": {
            "type": { "enum": ["github", "huggingface", "oci"] },
            "repository": { "type": "string", "minLength": 3 },
            "revision": { "type": "string", "minLength": 7 }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["framework", "architecture"],
      "properties": {
        "framework": { "type": "string" },
        "architecture": { "type": "string" },
        "container_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "hardware": {
      "type": "object",
      "required": ["robot_family"],
      "properties": {
        "robot_family": { "type": "string" },
        "end_effector": { "type": "string" },
        "sensors": { "type": "array", "items": { "type": "object" } }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["control_frequency_hz"],
      "properties": {
        "ros_distribution": { "type": "string" },
        "control_frequency_hz": { "type": "number", "exclusiveMinimum": 0 },
        "accelerator": { "type": "string" }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["benchmark", "trials"],
      "properties": {
        "benchmark": { "type": "string" },
        "trials": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" }
      }
    }
  }
}
